*.pyc
*.pyo
build/
dist/
sessions/
uploads/
output/
logs/
*.log
.secret_key
*.db
*.spec
# data/ — 仅忽略数据库文件，保留脚本和种子数据
data/*.db
data/*.db-wal
data/*.db-shm
